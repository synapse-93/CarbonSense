# Frontend environment
# Optional: Set VITE_BACKEND_URL to your Flask/Docker backend URL (e.g. http://localhost:5000 or https://your-backend.railway.app)
# If left empty, requests automatically use the native relative /api route (Vercel Serverless or Vite dev proxy).
VITE_BACKEND_URL=

# Backend proxy (Optional Vercel Environment Variable)
# If set on Vercel, serverless functions in api/ can also proxy upstream to your custom Python Flask server.
# BACKEND_URL=https://your-backend.railway.app
